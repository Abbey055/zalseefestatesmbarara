{
  "installCommand": "npm install --prefix zalsee-estates",
  "buildCommand": "npm --prefix zalsee-estates run build",
  "outputDirectory": "zalsee-estates/dist",
  "headers": [
    {
      "source": "/(images|fonts|css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
